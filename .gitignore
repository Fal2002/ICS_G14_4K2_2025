*.manifest
*.spec

# Archivos de testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Archivos de traducción
*.mo
*.pot

# Archivos de documentación
docs/_build/
doc/_build/

# Archivos de IDEs
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.pydevproject

# Archivos de macOS y Linux
.DS_Store
Thumbs.db
*.swp
*.swo

# Archivos temporales del sistema
~$*
*.bak
*.tmp
*.temp

# Archivos de herramientas de análisis
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Archivos de proyectos Docker / CI
*.pid
*.seed
celerybeat-schedule
