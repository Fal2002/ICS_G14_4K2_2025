# =========================
# Archivos de Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# Archivos de entorno virtual
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Archivos de configuración local
*.env
*.ini
*.cfg
*.local
*.toml

# Archivos de logs y bases de datos
*.log
*.sqlite3
*.db

# Archivos de compilación
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Archivos de instalación
*.egg-info/
.installed.cfg
*.egg

# Archivos de Jupyter Notebooks
.ipynb_checkpoints

# Archivos de PyInstaller
